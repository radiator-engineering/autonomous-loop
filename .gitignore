.install-backup/

# macOS Finder metadata.
.DS_Store

# Ephemeral loop run dirs: ledger, driver, captures. Served, never shipped.
.loop/

# Python build output. install.sh excludes it; git should too — it once shipped to four homes.
__pycache__/
*.pyc
